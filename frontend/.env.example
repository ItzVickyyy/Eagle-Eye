# Eagle Eye frontend (Vite) environment template.
#
# Copy this file to `.env` in this directory and adapt as needed. It is gitignored;
# do not commit real values.
#
# Base URL of the Eagle Eye backend API. When left empty, the frontend calls the
# same origin it was served from (used in production deployment).
VITE_API_URL=

# Location of the Mailpit web UI, used only by local end-to-end tests
# (frontend/tests/utils/mailpit.ts) to read verification emails. Safe to leave
# commented out for app-only development.
# MAILPIT_HOST=http://localhost:8025