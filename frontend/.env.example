# Eagle Eye frontend (Vite) environment template.
#
# Copy this file to `.env` in this directory and adapt as needed. It is gitignored;
# do not commit real values.
#
# Base URL of the Eagle Eye backend API. When left empty, the frontend calls the
# same origin it was served from (used in production deployment).
VITE_API_URL=

# Cloudflare Turnstile public site key. Required when CAPTCHA_ENABLED=true on
# the backend so the SPA can render the Turnstile widget on signup,
# password-recovery, password-reset, and contact forms. The matching secret
# key (TURNSTILE_SECRET_KEY) lives in the backend .env and must NEVER be set
# here. The backend validates the full set (CAPTCHA_ENABLED + TURNSTILE_SITE_KEY
# + TURNSTILE_SECRET_KEY + VITE_TURNSTILE_SITE_KEY) at startup and refuses to
# boot if any is missing in production.
# VITE_TURNSTILE_SITE_KEY=

# Location of the Mailpit web UI, used only by local end-to-end tests
# (frontend/tests/utils/mailpit.ts) to read verification emails. Safe to leave
# commented out for app-only development.
# MAILPIT_HOST=http://localhost:8025