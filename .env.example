# Eagle Eye backend/development environment template.
#
# Copy this file to `.env` (e.g. `cp .env.example .env`) and replace every value
# with a real value. NEVER commit your real `.env` — it is gitignored.
#
# Required secrets/variables (no default; must be set):
SECRET_KEY=change-me-generate-a-random-secret
PROJECT_NAME=Eagle Eye
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/app
POSTGRES_PASSWORD=change-me
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=change-me

# Deployment (used by docker compose / compose.deploy.yml)
# DOMAIN is required in production compose when FRONTEND_HOST derives from it.
# DOMAIN=example.com

# Backend runtime
# FASTAPI_ENV=development
# FRONTEND_HOST=http://localhost:5173
# ACCESS_TOKEN_EXPIRE_MINUTES=11520
# SENTRY_DSN=

# Media storage
#
# Two backends are supported:
#
#   local (default): files are written to the host-mounted directory
#     named by MEDIA_STORAGE_LOCAL_DIR. The app resolves this to an
#     ABSOLUTE path under the backend/ folder (Path(__file__).parent.parent /
#     MEDIA_STORAGE_LOCAL_DIR == /app/backend/ + MEDIA_STORAGE_LOCAL_DIR),
#     default /app/backend/uploads inside the container. PRODUCTION
#     DEPLOYMENTS MUST mount a named volume at that exact path or
#     uploads will be lost when the container is recreated.
#     compose.deploy.yml already declares
#     `app-uploads-data:/app/backend/uploads` for that purpose, so
#     keeping the default `local` + `uploads` in prod is supported.
#     If you change MEDIA_STORAGE_LOCAL_DIR you MUST also change the
#     volume mount target in compose.deploy.yml.
#
#   s3: files are written to an S3-compatible bucket. RECOMMENDED FOR
#     PRODUCTION when you have multiple replicas or stateless nodes,
#     because the local volume only sticks to a single container.
#     When using s3, the app never reads or writes from
#     MEDIA_STORAGE_LOCAL_DIR and the named volume mount can be
#     removed from compose.deploy.yml.
# MEDIA_STORAGE_BACKEND=local
# MEDIA_STORAGE_LOCAL_DIR=uploads
#
# Per-kind upload size limits (bytes). Image: 15 MiB, Video: 100 MiB.
# MAX_UPLOAD_BYTES_IMAGE=15728640
# MAX_UPLOAD_BYTES_VIDEO=104857600
#
# S3-compatible backend (used when MEDIA_STORAGE_BACKEND=s3).
# Works with AWS S3, Cloudflare R2, Backblaze B2, MinIO, etc.
# MEDIA_S3_BUCKET=your-bucket-name
# MEDIA_S3_REGION=auto
# MEDIA_S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# MEDIA_S3_ACCESS_KEY=replace-me
# MEDIA_S3_SECRET_KEY=replace-me
# MEDIA_S3_PUBLIC_URL_BASE=https://media.example.com

# Email / SMTP (optional; used for password-reset and test emails)
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_PORT=587
# SMTP_TLS=true
# SMTP_SSL=false
# EMAILS_FROM_EMAIL=noreply@example.com
# EMAILS_FROM_NAME =
# EMAIL_RESET_TOKEN_EXPIRE_HOURS=48
# EMAIL_TEST_USER=test@example.com

# Redis (optional). When set, rate limiting for /login/access-token,
# /password-recovery, /reset-password, /signup, /contact, and /comments
# is enforced in a shared Redis instance so the limit is honored across
# all backend workers. When unset (or unreachable), each worker falls
# back to its own in-memory limiter (legacy behavior). The default
# compose files do not start a Redis service; production deployments
# using `docker compose -f compose.deploy.yml up` will get one once the
# REDIS_URL is provided.
# REDIS_URL=redis://localhost:6379/0